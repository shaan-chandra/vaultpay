// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Merchant {
  id                  String         @id @default(uuid())
  name                String    
  email               String         @unique 
  password            String    
  company             String 
  contact             String         @db.VarChar(10)
  balance             Int            @default(0)
  commissionPercent   Int    
  status              MerchantStatus @default(ACTIVE)
  statusReason        String?
  statusUpdatedAt     DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  paymentLinks        PaymentLink[]
  payments            Payment[]
  statusEvents        MerchantStatusEvent[]

  @@index([status])
}

model MerchantStatusEvent {
  id          String         @id @default(uuid())
  merchantId  String
  merchant    Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  fromStatus  MerchantStatus
  toStatus    MerchantStatus
  reason      String
  actorId     String
  createdAt   DateTime       @default(now())

  @@index([merchantId, createdAt])
}
model PaymentLink {
  id                String             @id @default(uuid())
  merchantId        String      
  merchant          Merchant           @relation(fields:[merchantId], references: [id])
  type              PaymentLinkType 
  amount            Int?
  description       String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  payments          Payment[]

}
model Payment {
  id                String            @id @default(uuid())
  paymentLinkId     String
  paymentLink       PaymentLink       @relation(fields: [paymentLinkId], references: [id])
  merchantId        String
  merchant          Merchant          @relation(fields: [merchantId], references: [id])
  amountPaid        Int
  commissionPaise   Int
  merchantCredit    Int
  status            PaymentStatus     @default(PENDING)
  payerId           String?
  payer             Payer?            @relation(fields: [payerId], references: [id])
  payerEmail        String?
  createdAt         DateTime          @default(now())

  cardFingerprint   String?
  cardLast4         String?
  processorRef      String?
  fraudScore        FraudScore?

  @@index([merchantId])
  @@index([cardFingerprint, createdAt])
  @@index([merchantId, status, createdAt])
}

model Payer {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  payments  Payment[]
}

model FraudScore {
  id        String        @id @default(uuid())
  paymentId String        @unique
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  score     Int
  decision  FraudDecision
  reasons   Json
  createdAt DateTime      @default(now())

  @@index([decision, createdAt])
}

enum FraudDecision {
  ALLOW
  REVIEW
  BLOCK
}

enum MerchantStatus {
  ACTIVE
  UNDER_REVIEW // can sign in and read, cannot take new payments
  BLOCKED
}

enum PaymentLinkType {
  FIXED 
  OPEN 
}
enum PaymentStatus {
  PENDING 
  SUCCEEDED 
  FAILED 
  BLOCKED
}